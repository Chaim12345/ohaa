<?xml version="1.0" encoding="utf-8"?>
<!--
   Pre-API-31 equivalent of data_extraction_rules.xml: keep credentials
   (the OpenHands API key in `openhands_prefs`, session keys in
   `openhands_cloud.db`) off any backup.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="openhands_prefs.xml" />
    <exclude domain="database" path="openhands_cloud.db" />
</full-backup-content>
