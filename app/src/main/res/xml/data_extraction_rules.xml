<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude the preferences file that stores the OpenHands API key from backups and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="openhands_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="openhands_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
