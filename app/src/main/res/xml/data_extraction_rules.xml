<?xml version="1.0" encoding="utf-8"?>
<!--
   Excludes credentials from cloud backup and device transfer.
   `openhands_prefs` holds the user's OpenHands API key and base URL;
   `openhands_cloud.db` caches each conversation's session_api_key, which can
   drive the sandbox runtime. Neither should leave the device.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="openhands_prefs.xml" />
        <exclude domain="database" path="openhands_cloud.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="openhands_prefs.xml" />
        <exclude domain="database" path="openhands_cloud.db" />
    </device-transfer>
</data-extraction-rules>
